{
  "name": "barberpro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:railway": "npm install --include=dev --no-fund --no-audit && cd server && npm install --no-fund --no-audit && npx prisma generate && cd .. && npm run build",
    "postinstall": "cd server && npm install && npx prisma generate",
    "start:prod": "cd server && node index.js",
    "db:seed": "cd server && npx prisma db seed",
    "db:migrate:deploy": "cd server && npx prisma migrate deploy",
    "db:railway:setup": "node server/scripts/railway_db_setup.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --exclude server/tests/**",
    "test:api": "vitest run server/tests",
    "test:security": "vitest run server/tests/security server/src/utils/auth.test.js server/src/lib/tenantModules.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@material/web": "^2.4.1",
    "@supabase/supabase-js": "^2.106.1",
    "gsap": "3.15",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.12",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.10"
  }
}
