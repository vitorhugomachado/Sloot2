# Frontend (Vite) — copia para .env na raiz (build local)
# Produção: define VITE_* nas Variables do Railway (serviço app) antes do deploy

VITE_GOOGLE_CLIENT_ID=

# Não definir VITE_API_URL — em produção usa /api na mesma origem (Railway)

VITE_DEFAULT_TENANT_SLUG=two-brothers

# Landing — WhatsApp comercial (DDI + DDD + número, só dígitos)
VITE_LANDING_WHATSAPP_PHONE=5511999999999

