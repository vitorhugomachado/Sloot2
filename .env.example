# Frontend (Vite) environment variables.
# Copia este ficheiro para .env e preenche os valores reais.
# IMPORTANTE: tem de ser exatamente o MESMO Client ID que GOOGLE_CLIENT_ID em server/.env

# Igual a GOOGLE_CLIENT_ID no server (vazio no projeto até configurares Google Cloud)
VITE_GOOGLE_CLIENT_ID=

# Em produção não definir — usa /api na mesma origem
# VITE_API_URL=

# Intervalo de sync da agenda no painel staff (ms). Dev com várias abas: 30000–60000
# VITE_APPOINTMENTS_POLL_MS=30000

# Tenant padrão da tela de protótipo /telateste (qualquer domínio)
# VITE_PREVIEW_TENANT_SLUG=lanotic

# Slug padrão em produção (deve coincidir com DEFAULT_TENANT_SLUG no server)
# VITE_DEFAULT_TENANT_SLUG=two-brothers

# Railway: copiar de docs/railway-variables.env → docs/DEPLOY-RAILWAY.md
