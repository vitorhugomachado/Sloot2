# Copiar para docs/railway-variables.env (gitignore) e colar no Railway → serviço APP → Variables
# Postgres: usa referência ao serviço PostgreSQL do mesmo projeto (não Supabase)

NODE_ENV=production

DATABASE_URL=${{Postgres.DATABASE_URL}}
DIRECT_URL=${{Postgres.DATABASE_URL}}

JWT_SECRET=gera-com-openssl-rand-base64-48
DEFAULT_TENANT_SLUG=two-brothers

FRONTEND_URL=https://TEU-DOMINIO.up.railway.app

VITE_DEFAULT_TENANT_SLUG=two-brothers
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Recuperação de senha (Supabase Auth) — ver docs/SUPABASE-RESET-SENHA.md
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Não definir PORT (quebra healthcheck do Railway)
# Não definir VITE_API_URL (API na mesma origem /api)
