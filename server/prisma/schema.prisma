generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  name           String
  status         String   @default("active")
  phone          String   @default("")
  email          String   @default("")
  address        String   @default("")
  logo_url       String?
  banner_url     String?
  tagline        String?
  slogan         String?
  instagram_url  String?
  facebook_url   String?
  whatsapp_url   String?
  show_instagram Boolean  @default(false)
  show_facebook  Boolean  @default(false)
  show_whatsapp  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  barbers                 Barber[]
  customers               Customer[]
  services                Service[]
  appointments            Appointment[]
  products                Product[]
  productSales            ProductSale[]
  expenses                Expense[]
  monthClosings           MonthClosing[]
  financialPeriodClosings FinancialPeriodClosing[]
  scheduleBlocks          BarberScheduleBlock[]
  workingHours            WorkingHours[]
  holidays                Holiday[]
}

model Barber {
  id            Int             @id @default(autoincrement())
  tenantId      Int
  name          String
  email         String
  password      String
  role          String
  status        String          @default("Ativo")
  foto_perfil   String?
  deletedAt     DateTime?
  permissions   Json
  whatsapp      String?
  bio           String?
  specialties   Json?
  commission    Float?          @default(50)
  chave_pix     String?
  data_admissao String?
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Appointment      Appointment[]
  ProductSale      ProductSale[]
  shifts           WorkingShifts[]
  scheduleBlocks   BarberScheduleBlock[]

  @@unique([tenantId, email], map: "Barber_tenantId_email_key")
  @@index([tenantId], map: "idx_barber_tenant")
  @@index([deletedAt], map: "idx_barber_deleted")
}

model Service {
  id       Int    @id @default(autoincrement())
  tenantId Int
  name     String
  price    Float
  duration String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "idx_service_tenant")
}

model Customer {
  id        Int       @id @default(autoincrement())
  tenantId  Int
  name      String
  email     String?
  password  String?
  phone     String
  createdAt DateTime  @default(now())
  birthday  DateTime? @db.Date
  notes     String?
  tags          Json?
  updatedAt     DateTime      @default(now()) @updatedAt
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productSales  ProductSale[]

  @@unique([tenantId, email], map: "Customer_tenantId_email_key")
  @@index([tenantId], map: "idx_customer_tenant")
  @@index([phone], map: "idx_customer_phone")
}

model Appointment {
  id              Int     @id @default(autoincrement())
  tenantId        Int
  customer        String
  phone           String?
  service         String
  barberId        Int
  date            String
  time            String
  status          String  @default("Agendado")
  price           Float
  payments        Json?
  customer_id     Int?
  customer_rating Int?
  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Barber          Barber  @relation(fields: [barberId], references: [id])

  @@index([tenantId], map: "idx_appointment_tenant")
  @@index([barberId], map: "idx_appointment_barber")
  @@index([date], map: "idx_appointment_date")
  @@index([status], map: "idx_appointment_status")
}

model Product {
  id       Int    @id @default(autoincrement())
  tenantId Int
  name     String
  price    Float
  cost     Float
  stock    Int
  category String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "idx_product_tenant")
}

model ProductSale {
  id           Int       @id @default(autoincrement())
  tenantId     Int
  productId    Int
  productName  String
  price        Float
  cost         Float
  quantity     Int
  date         String
  barberId     Int?
  customerId   Int?
  customerName String?
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Barber       Barber?   @relation(fields: [barberId], references: [id])
  Customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId], map: "idx_productsale_tenant")
  @@index([date], map: "idx_productsale_date")
  @@index([customerId], map: "idx_productsale_customer")
}

model Expense {
  id          Int     @id @default(autoincrement())
  tenantId    Int
  description String
  amount      Float
  date        String
  category    String?
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "idx_expense_tenant")
}

model MonthClosing {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  yearMonth    String
  closedAt     DateTime @default(now())
  closedById   Int?
  closedByName String?
  snapshot     Json
  notes        String?
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, yearMonth], map: "MonthClosing_tenantId_yearMonth_key")
  @@index([tenantId], map: "idx_monthclosing_tenant")
  @@index([yearMonth], map: "idx_monthclosing_year_month")
}

model FinancialPeriodClosing {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  startDate    String
  endDate      String
  scope        String
  barberId     Int      @default(0)
  closedAt     DateTime @default(now())
  closedById   Int?
  closedByName String?
  snapshot     Json
  notes        String?
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, startDate, endDate, scope, barberId], map: "uniq_period_closing_tenant_range_scope_barber")
  @@index([tenantId], map: "idx_period_closing_tenant")
  @@index([closedAt], map: "idx_period_closing_closed")
}

model WorkingHours {
  tenantId        Int
  dia_semana      Int
  is_aberto       Boolean?  @default(true)
  hora_abertura   DateTime  @db.Time(6)
  hora_fechamento DateTime  @db.Time(6)
  almoco_inicio   DateTime? @db.Time(6)
  almoco_fim      DateTime? @db.Time(6)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, dia_semana])
  @@map("horarios_funcionamento")
}

model Holiday {
  id        BigInt   @id @default(autoincrement())
  tenantId  Int
  data      DateTime @db.Date
  descricao String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, data], map: "Holiday_tenantId_data_key")
  @@map("feriados")
}

model WorkingShifts {
  id_barbeiro   Int
  dia_semana    Int
  hora_inicio   String
  hora_fim      String
  ativo         Boolean? @default(true)
  almoco_inicio String?
  almoco_fim    String?
  barber        Barber   @relation(fields: [id_barbeiro], references: [id], onDelete: Cascade)

  @@id([id_barbeiro, dia_semana, hora_inicio])
  @@map("horarios_trabalho")
}

model BarberScheduleBlock {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  barberId  Int
  date      String
  startTime String?
  endTime   String?
  reason    String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "idx_schedule_block_tenant")
  @@index([barberId, date], map: "idx_barber_schedule_block_date")
  @@map("barber_schedule_blocks")
}

model agendamentos {
  id                    BigInt          @id @default(autoincrement())
  id_cliente            String?         @db.Uuid
  id_barbeiro           BigInt
  id_servico            BigInt
  data_hora_agendamento DateTime        @db.Timestamptz(6)
  status                booking_status? @default(Pendente)
  valor                 Decimal         @db.Decimal(10, 2)
  created_at            DateTime?       @default(now()) @db.Timestamptz(6)
  deleted_at            DateTime?       @db.Timestamptz(6)
}

model PlatformAdmin {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  status    String   @default("active")
  createdAt DateTime @default(now())
}

enum booking_status {
  Pendente
  Confirmado
  Concluido
  Cancelado
  No_Show    @map("No-Show")
}
