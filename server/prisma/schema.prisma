generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  name           String
  status         String   @default("active")
  phone          String   @default("")
  email          String   @default("")
  address        String   @default("")
  logo_url       String?
  banner_url     String?
  tagline        String?
  slogan         String?
  instagram_url  String?
  facebook_url   String?
  whatsapp_url   String?
  show_instagram Boolean  @default(false)
  show_facebook  Boolean  @default(false)
  show_whatsapp  Boolean  @default(false)
  enabledModules Json     @default("[\"dashboard\",\"scheduler\",\"clients\",\"finance\",\"users\",\"inventory\",\"settings\"]")
  /// Meta mensal de receita (KPIs Financeiro V2)
  monthlyRevenueGoal Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  barbers                 Barber[]
  customers               Customer[]
  services                Service[]
  appointments            Appointment[]
  products                Product[]
  productSales            ProductSale[]
  purchaseOrders          PurchaseOrder[]
  expenses                Expense[]
  monthClosings           MonthClosing[]
  financialPeriodClosings FinancialPeriodClosing[]
  scheduleBlocks          BarberScheduleBlock[]
  workingHours            WorkingHours[]
  holidays                Holiday[]
  pushSubscriptions       PushSubscription[]
  financeCategories       FinanceCategory[]
  cashSessions            CashSession[]
  cashMovements           CashMovement[]
  comandas                Comanda[]
  commissionPayouts       CommissionPayout[]
  accountMovements        AccountMovement[]
  ledgerEntries           LedgerEntry[]
  financeAuditLogs        FinanceAuditLog[]
  financeClosings         FinanceClosing[]
  cardFeeRates            CardFeeRate[]
}

model Barber {
  id            Int             @id @default(autoincrement())
  tenantId      Int
  name          String
  email         String
  password      String
  role          String
  status        String          @default("Ativo")
  foto_perfil   String?
  deletedAt     DateTime?
  permissions   Json
  whatsapp      String?
  bio           String?
  specialties   Json?
  commission    Float?          @default(50)
  chave_pix     String?
  data_admissao String?
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Appointment      Appointment[]
  ProductSale      ProductSale[]
  shifts           WorkingShifts[]
  scheduleBlocks   BarberScheduleBlock[]
  pushSubscriptions PushSubscription[]

  @@unique([tenantId, email], map: "Barber_tenantId_email_key")
  @@index([tenantId], map: "idx_barber_tenant")
  @@index([deletedAt], map: "idx_barber_deleted")
}

model Service {
  id            Int    @id @default(autoincrement())
  tenantId      Int
  name          String
  price         Float
  duration      String
  /// % que o profissional recebe sobre o preço do serviço (0–100). Default 50.
  commissionPct Float? @default(50)
  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "idx_service_tenant")
}

model Customer {
  id        Int       @id @default(autoincrement())
  tenantId  Int
  name      String
  email     String?
  password  String?
  phone     String
  createdAt DateTime  @default(now())
  birthday  DateTime? @db.Date
  notes     String?
  tags          Json?
  updatedAt     DateTime      @default(now()) @updatedAt
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productSales  ProductSale[]

  @@unique([tenantId, email], map: "Customer_tenantId_email_key")
  @@index([tenantId], map: "idx_customer_tenant")
  @@index([phone], map: "idx_customer_phone")
}

model Appointment {
  id              Int     @id @default(autoincrement())
  tenantId        Int
  customer        String
  phone           String?
  service         String
  barberId        Int
  date            String
  time            String
  status          String  @default("Agendado")
  price           Float
  payments        Json?
  customer_id     Int?
  customer_rating Int?
  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Barber          Barber  @relation(fields: [barberId], references: [id])

  @@index([tenantId], map: "idx_appointment_tenant")
  @@index([barberId], map: "idx_appointment_barber")
  @@index([date], map: "idx_appointment_date")
  @@index([status], map: "idx_appointment_status")
}

model Product {
  id       Int    @id @default(autoincrement())
  tenantId Int
  name     String
  price    Float
  cost     Float
  stock    Int
  category String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrderItems PurchaseOrderItem[]

  @@index([tenantId], map: "idx_product_tenant")
}

model PurchaseOrder {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  supplier      String   @default("")
  status        String   @default("OPEN")
  notes         String?
  orderedAt     DateTime @default(now())
  receivedAt    DateTime?
  total         Float    @default(0)
  expenseId     Int?
  paymentMethod String?
  account       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expense       Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  items         PurchaseOrderItem[]

  @@index([tenantId], map: "idx_purchase_order_tenant")
  @@index([tenantId, status], map: "idx_purchase_order_tenant_status")
  @@index([expenseId], map: "idx_purchase_order_expense")
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  productId       Int
  productName     String
  quantity        Int
  unitCost        Float
  total           Float
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId], map: "idx_purchase_order_item_order")
  @@index([productId], map: "idx_purchase_order_item_product")
}

model ProductSale {
  id           Int       @id @default(autoincrement())
  tenantId     Int
  productId    Int
  productName  String
  price        Float
  cost         Float
  quantity     Int
  date         String
  barberId     Int?
  customerId   Int?
  customerName String?
  /// Vínculo com comanda do Financeiro V2 (null = venda legada / avulsa antiga)
  comandaId    Int?
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Barber       Barber?   @relation(fields: [barberId], references: [id])
  Customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  comanda      Comanda?  @relation(fields: [comandaId], references: [id], onDelete: SetNull)

  @@index([tenantId], map: "idx_productsale_tenant")
  @@index([date], map: "idx_productsale_date")
  @@index([customerId], map: "idx_productsale_customer")
  @@index([comandaId], map: "idx_productsale_comanda")
}

model Expense {
  id              Int           @id @default(autoincrement())
  tenantId        Int
  description     String
  amount          Float
  date            String
  category        String?
  title           String?
  dueDate         String?
  competenceDate  String?
  account         String?       @default("CAIXA")
  supplier        String?
  costCenter      String?
  paymentMethod   String?
  status          String?       @default("PAID")
  paidAt          String?
  invoiceNote     String?
  notes           String?
  cashSessionId   Int?
  categoryId      Int?
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashSession     CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  financeCategory FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  purchaseOrders  PurchaseOrder[]

  @@index([tenantId], map: "idx_expense_tenant")
  @@index([status], map: "idx_expense_status")
  @@index([dueDate], map: "idx_expense_due_date")
  @@index([categoryId], map: "idx_expense_category")
}

model FinanceCategory {
  id       Int      @id @default(autoincrement())
  tenantId Int
  name     String
  kind     String
  slug     String?
  parentId Int?
  createdAt DateTime @default(now())
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   FinanceCategory?  @relation("FinanceCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children FinanceCategory[] @relation("FinanceCategoryTree")
  expenses Expense[]
  comandas Comanda[]

  @@unique([tenantId, kind, name], map: "FinanceCategory_tenant_kind_name_key")
  @@index([tenantId], map: "idx_finance_category_tenant")
  @@index([parentId], map: "idx_finance_category_parent")
}

model CashSession {
  id            Int       @id @default(autoincrement())
  tenantId      Int
  status        String    @default("OPEN")
  openedAt      DateTime  @default(now())
  openedById    Int?
  openedByName  String?
  closedAt      DateTime?
  closedById    Int?
  closedByName  String?
  openingFloat  Float     @default(0)
  countedCash   Float?
  notes         String?
  snapshot      Json?
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements     CashMovement[]
  comandas      Comanda[]
  expenses      Expense[]

  @@index([tenantId], map: "idx_cash_session_tenant")
  @@index([tenantId, status], map: "idx_cash_session_tenant_status")
}

model CashMovement {
  id            Int         @id @default(autoincrement())
  tenantId      Int
  cashSessionId Int
  type          String
  source        String
  amount        Float
  method        String      @default("Outro")
  description   String
  referenceType String?
  referenceId   Int?
  createdAt     DateTime    @default(now())
  createdById   Int?
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "idx_cash_movement_tenant")
  @@index([cashSessionId], map: "idx_cash_movement_session")
  @@index([createdAt], map: "idx_cash_movement_created")
}

model Comanda {
  id            Int       @id @default(autoincrement())
  tenantId      Int
  number        Int
  customerName  String
  customerId    Int?
  appointmentId Int?      @unique
  cashSessionId Int?
  status        String    @default("OPEN")
  origin        String    @default("AGENDA")
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  total         Float     @default(0)
  payments      Json?
  notes         String?
  barberId      Int?
  categoryId    Int?
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  financeCategory FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items         ComandaItem[]
  productSales  ProductSale[]

  @@unique([tenantId, number], map: "Comanda_tenantId_number_key")
  @@index([tenantId], map: "idx_comanda_tenant")
  @@index([tenantId, status], map: "idx_comanda_tenant_status")
  @@index([openedAt], map: "idx_comanda_opened")
  @@index([closedAt], map: "idx_comanda_closed")
}

model ComandaItem {
  id            Int     @id @default(autoincrement())
  comandaId     Int
  itemType      String
  name          String
  quantity      Int     @default(1)
  unitPrice     Float
  total         Float
  productId     Int?
  serviceId     Int?
  barberId      Int?
  /// Snapshot do % do profissional no momento da quitação (só SERVICE).
  commissionPct Float?
  comanda       Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)

  @@index([comandaId], map: "idx_comanda_item_comanda")
}

/// Status de Comanda é String — PARTIAL (pagamento parcial) funciona sem migration adicional.
model CommissionPayout {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  barberId      Int
  periodStart   String
  periodEnd     String
  amount        Float
  method        String   @default("CAIXA")
  cashSessionId Int?
  notes         String?
  createdById   Int?
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "idx_commission_payout_tenant")
  @@index([barberId], map: "idx_commission_payout_barber")
}

/// Taxa da maquininha por bandeira e tipo (débito/crédito). Debitada da comissão do barbeiro.
model CardFeeRate {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  brand     String // Visa | Mastercard | Elo | Amex | Hipercard | Outra
  kind      String // DEBIT | CREDIT
  feePct    Float    @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, brand, kind], map: "CardFeeRate_tenant_brand_kind_key")
  @@index([tenantId], map: "idx_card_fee_rate_tenant")
}

model AccountMovement {
  id             Int      @id @default(autoincrement())
  tenantId       Int
  account        String // CAIXA | BANCO
  type           String // IN | OUT | TRANSFER
  amount         Float
  date           String // YYYY-MM-DD
  description    String
  referenceType  String?
  referenceId    Int?
  counterAccount String? // for transfers
  cashSessionId  Int?
  createdById    Int?
  createdAt      DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "idx_account_movement_tenant")
  @@index([tenantId, account], map: "idx_account_movement_tenant_account")
  @@index([date], map: "idx_account_movement_date")
}

model LedgerEntry {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  occurredAt    DateTime @default(now())
  kind          String // INCOME | EXPENSE | ADJUSTMENT | COMMISSION | TRANSFER
  amount        Float // positive; direction via direction field
  direction     String // IN | OUT
  method        String?
  account       String   @default("CAIXA")
  referenceType String?
  referenceId   Int?
  description   String
  createdById   Int?
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "idx_ledger_entry_tenant")
  @@index([tenantId, occurredAt], map: "idx_ledger_entry_tenant_occurred")
  @@index([referenceType, referenceId], map: "idx_ledger_entry_reference")
}

model FinanceAuditLog {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  userId    Int?
  userName  String?
  action    String
  entity    String
  entityId  Int?
  payload   Json?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt], map: "idx_finance_audit_tenant_created")
}

model FinanceClosing {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  periodStart  String
  periodEnd    String
  closedAt     DateTime @default(now())
  closedById   Int?
  closedByName String?
  snapshot     Json
  notes        String?
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodStart, periodEnd], map: "FinanceClosing_tenant_period_key")
  @@index([tenantId], map: "idx_finance_closing_tenant")
}

model MonthClosing {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  yearMonth    String
  closedAt     DateTime @default(now())
  closedById   Int?
  closedByName String?
  snapshot     Json
  notes        String?
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, yearMonth], map: "MonthClosing_tenantId_yearMonth_key")
  @@index([tenantId], map: "idx_monthclosing_tenant")
  @@index([yearMonth], map: "idx_monthclosing_year_month")
}

model FinancialPeriodClosing {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  startDate    String
  endDate      String
  scope        String
  barberId     Int      @default(0)
  closedAt     DateTime @default(now())
  closedById   Int?
  closedByName String?
  snapshot     Json
  notes        String?
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, startDate, endDate, scope, barberId], map: "uniq_period_closing_tenant_range_scope_barber")
  @@index([tenantId], map: "idx_period_closing_tenant")
  @@index([closedAt], map: "idx_period_closing_closed")
}

model WorkingHours {
  tenantId        Int
  dia_semana      Int
  is_aberto       Boolean?  @default(true)
  hora_abertura   DateTime  @db.Time(6)
  hora_fechamento DateTime  @db.Time(6)
  almoco_inicio   DateTime? @db.Time(6)
  almoco_fim      DateTime? @db.Time(6)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, dia_semana])
  @@map("horarios_funcionamento")
}

model Holiday {
  id        BigInt   @id @default(autoincrement())
  tenantId  Int
  data      DateTime @db.Date
  descricao String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, data], map: "Holiday_tenantId_data_key")
  @@map("feriados")
}

model WorkingShifts {
  id_barbeiro   Int
  dia_semana    Int
  hora_inicio   String
  hora_fim      String
  ativo         Boolean? @default(true)
  almoco_inicio String?
  almoco_fim    String?
  barber        Barber   @relation(fields: [id_barbeiro], references: [id], onDelete: Cascade)

  @@id([id_barbeiro, dia_semana, hora_inicio])
  @@map("horarios_trabalho")
}

model BarberScheduleBlock {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  barberId  Int
  date      String
  startTime String?
  endTime   String?
  reason    String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "idx_schedule_block_tenant")
  @@index([barberId, date], map: "idx_barber_schedule_block_date")
  @@map("barber_schedule_blocks")
}

model agendamentos {
  id                    BigInt          @id @default(autoincrement())
  id_cliente            String?         @db.Uuid
  id_barbeiro           BigInt
  id_servico            BigInt
  data_hora_agendamento DateTime        @db.Timestamptz(6)
  status                booking_status? @default(Pendente)
  valor                 Decimal         @db.Decimal(10, 2)
  created_at            DateTime?       @default(now()) @db.Timestamptz(6)
  deleted_at            DateTime?       @db.Timestamptz(6)
}

model PlatformAdmin {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  status    String   @default("active")
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  barberId  Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([tenantId, barberId], map: "idx_push_subscription_tenant_barber")
  @@map("push_subscriptions")
}

enum booking_status {
  Pendente
  Confirmado
  Concluido
  Cancelado
  No_Show    @map("No-Show")
}
