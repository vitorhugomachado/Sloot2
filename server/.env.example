# Backend — copia para server/.env (local) ou Railway Variables (produção)

# Postgres Railway (mesmo valor em DATABASE_URL e DIRECT_URL)
# Local com TCP Proxy: postgresql://postgres:...@HOST.proxy.rlwy.net:PORT/railway
# No Railway app: ${{Postgres.DATABASE_URL}}
DATABASE_URL=
DIRECT_URL=

PORT=3001
JWT_SECRET=change-me-in-production

DEFAULT_TENANT_SLUG=two-brothers
GOOGLE_CLIENT_ID=

# Fuso para validação de horários (agendamento). Padrão: America/Sao_Paulo
# APP_TIMEZONE=America/Sao_Paulo

# Recuperação de senha do cliente (Supabase Auth — e-mail + link)
# Supabase → Project Settings → API
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Web Push — notificações ao staff quando cliente agenda online
# Gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@sua-barbearia.com.br

# Produção Railway
# NODE_ENV=production
# FRONTEND_URL=https://TEU-DOMINIO.up.railway.app

# Guia: docs/DEPLOY-RAILWAY.md
