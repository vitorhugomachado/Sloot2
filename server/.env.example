# Backend — copia para server/.env (local) ou Railway Variables (produção)

# Postgres Railway (mesmo valor em DATABASE_URL e DIRECT_URL)
# Local com TCP Proxy: postgresql://postgres:...@HOST.proxy.rlwy.net:PORT/railway
# No Railway app: ${{Postgres.DATABASE_URL}}
DATABASE_URL=
DIRECT_URL=

PORT=3001
JWT_SECRET=change-me-in-production

DEFAULT_TENANT_SLUG=two-brothers
GOOGLE_CLIENT_ID=

# Produção Railway
# NODE_ENV=production
# FRONTEND_URL=https://TEU-DOMINIO.up.railway.app

# Guia: docs/DEPLOY-RAILWAY.md
