# Backend environment variables.
# Copia este ficheiro para .env e preenche os valores reais.

# Postgres — Supabase (exemplo do projeto; substitui password no teu .env real)
# Pooler (app):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direto (migrations):
# DIRECT_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-1-us-west-2.pooler.supabase.com:5432/postgres
DATABASE_URL=

DIRECT_URL=

PORT=3001

# NODE_ENV=production

JWT_SECRET=change-me-in-production

GOOGLE_CLIENT_ID=

# Valores prontos para Railway: docs/railway-variables.env (não versionado)
# Guia: docs/DEPLOY-RAILWAY.md
