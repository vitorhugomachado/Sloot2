# Backend environment variables.
# Copia este ficheiro para .env e preenche os valores reais.

# Postgres — Supabase (substitui SENHA; se começar com @, use %40 na URL)
# Direto (recomendado em dev — mais rápido):
# DATABASE_URL=postgresql://postgres:SENHA@db.PROJECT_REF.supabase.co:5432/postgres
# DIRECT_URL=postgresql://postgres:SENHA@db.PROJECT_REF.supabase.co:5432/postgres
# Pooler (opcional em produção com muitas conexões):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

DIRECT_URL=

PORT=3001

# NODE_ENV=production

JWT_SECRET=change-me-in-production

GOOGLE_CLIENT_ID=

# Slug do tenant padrão (redirects /cliente → /:slug/cliente e seed)
DEFAULT_TENANT_SLUG=two-brothers

# Opcional no build Vite (fallback frontend): VITE_DEFAULT_TENANT_SLUG=two-brothers

# Valores prontos para Railway: docs/railway-variables.env (não versionado)
# Guia: docs/DEPLOY-RAILWAY.md
# Após 1º deploy com migrations: cd server && npm run create:platform-admin -- email senha
